# Set the region to match the existing Firestore deployment before deploying.
LANDING_REGION=us-central1
# Private existing Firebase Storage bucket, or a dedicated private bucket.
LANDING_BUCKET=plantillas-bfaeb.firebasestorage.app
# Comma-separated extra authorized editor origins (no trailing slash).
# For local authenticated tests only, add http://localhost:3000.
LANDING_ALLOWED_ORIGINS=
